    } ]
}, {
    "name": "Meticulous tests: Nullable Integer",
    "schema": {
        "$schema": "custom",
        "type": "integer",
        "nullable": true
    },
    "tests": [ {
        "name": "nullability test",
        "data": null,
        "expected": "valid"
    }, {
        "name": "Number (real) bad",
        "data": 1.5,
        "expected": "IncorrectDataType"
    }, {
        "name": "Integer good",
        "data": 100,
        "expected": "valid"
    }, {
        "name": "String bad",
        "data": "Arrr matey!  A pirate walked into a bar and ordered negative 1 beers.",
