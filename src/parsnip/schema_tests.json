        "data": 13,
        "expected": "InvalidValue"
    } ]
}, {
    "name": "Conjunction tests: not (a dictionary)",
    "schema": {
        "$schema": "not a dictionary",
        "additionalProperties": false,
        "not": {
                "type": "object"
        }
    },
    "tests": [ {
