        "expected": "valid"
    }, {
        "name": "List is not a dictionary",
        "data": [ 3, 5, "fish" ],
        "expected": "valid"
    }, {
        "name": "Null is not a dictionary",
        "data": null,
        "expected": "valid"
    }, {
        "name": "An empty dictionary is invalid",
        "data": {},
        "expected": "InvalidValue"
    } ]
}, {
    "name": "Regex built-in patterns: date",
    "schema": {
        "$schema": "custom",
        "type": "string",
        "format": "date"
      },
      "tests": [ {
          "name": "Valid date #2",
          "data": "0001-01-01",
          "expected": "valid"
      }, {
          "name": "Valid date #3",
          "data": "9999-09-31",
          "expected": "valid"
      }, {
          "name": "Valid date #4",
          "data": "2018-10-31",
          "expected": "valid"
      }, {
          "name": "Valid date #5",
          "data": "2018-12-01",
          "expected": "valid"
      }, {
          "name": "Invalid date #6",
          "data": "2018-00-01",
          "expected": "InvalidValue"
      }, {
          "name": "Invalid date #7",
          "data": "2018-13-00",
          "expected": "InvalidValue"
      }, {
          "name": "trailing junk",
