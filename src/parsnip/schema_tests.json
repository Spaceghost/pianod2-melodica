    } ]
}, {
    "name": "Meticulous tests: Nullable Boolean",
    "schema": {
        "$schema": "custom",
        "type": "boolean",
        "nullable": true
    },
    "tests": [ {
        "name": "nullability test",
        "data": null,
        "expected": "valid"
    }, {
        "name": "True good",
        "data": true,
        "expected": "valid"
    }, {
        "name": "False good",
        "data": false,
        "expected": "valid"
    }, {
        "name": "String bad",
        "data": "true",
        "expected": "IncorrectDataType"
    } ]
}, {
    "name": "Meticulous tests: Nullable List",
    "schema": {
        "$schema": "custom",
        "type": "array",
        "items": { "type": "string"},
