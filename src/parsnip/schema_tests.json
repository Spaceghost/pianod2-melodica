        "data": [ "foo", "bar" ],
        "expected": "valid"
    }, {
        "name": "Non-array bad",
        "data": "foo",
        "expected": "IncorrectDataType"
    } ]
}, {
    "name": "Conjunction tests: any of",
    "schema": {
        "$schema": "names and stuff",
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
            {
                "properties": {
                    "type": {
                        "type": "string",
                        "const": "person"
                    },
                    "name_family": {
                        "type": "string"
                    },
                    "name_given": {
                        "type": "string"
                    },
                    "phone_number": {
                        "type": "integer"
                    },
                },
                "required": [ "type", "name_given", "name_family" ]
            }, {
                "properties": {
                    "type": {
                        "type": "string",
                        "const": "pet"
                    },
                    "name_given": {
                        "type": "string"
                    },
                    "species": {
                        "type": "string"
                    }
                },
                "required": [ "type", "name_given", "species" ]
            }
        ]
    },
    "tests": [ {
        "name": "Valid Person",
        "data": {
            "type": "person",
            "name_family": "Bolton",
            "name_given": "Michael"
        },
        "expected": "valid"
    }, {
        "name": "Valid Pet",
        "data": {
            "type": "pet",
            "species": "Felis catus",
            "name_given": "Vit vit"
        },
        "expected": "valid"
    }, {
        "name": "Person with pet info",
        "data": {
            "type": "person",
            "species": "Homo sapiens",
            "name_given": "Biff"
        },
        "expected": "InvalidValue"
    }, {
        "name": "Cat with extra person info",
        "data": {
            "type": "pet",
            "species": "Felis Catus",
            "name_family": "Thanxamillion",
            "name_given": "Maxamillion"
        },
        "expected": "InvalidValue"
    } ]
}, {
