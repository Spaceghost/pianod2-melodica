"client.show ('activity')">Activité</a> <a onclick=
"client.show ('user')">Utilisateur</a> <a onclick=
"client.execute ('QUIT');">Déconnexion</a></div>
</div>
<div id="diagnostics" class="popup">
<div><a class="close button" onclick=
"$('#diagnostics').hide();">✖</a> <span id="diagmain">&nbsp;</span>
<div id="diagdetails">&nbsp;</div>
</div>
</div>
<div id="views">
<div id="loginview" style="display:none;">
<h1>pianod web à télécommande</h1>
<p>Copyright © 2011–2021 Devious Fish<br>
Tous droits réservés.<br>
