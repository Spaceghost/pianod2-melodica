		510: "Ausnahme",
		511: "Netzwerk Timeout",
		512: "Kann Audio-Ausgang nicht öffnen",
		'Bogus': 'Bogosity'
	};



	var MESSAGES = {
			"ERROR_LOGIN_FAILED": "LOGON verlassen",
	"ERROR_CONNECTION_FAILED": "Anschluss verlassen.",
	"ERROR_LOGIN_BAD_CREDENTIALS": "Falsche Bescheinigungen.",
